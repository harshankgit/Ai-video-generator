# Copy this file to .env and paste your FREE keys (all optional). Never commit .env.
# Free Gemini key (better + faster stories): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Cloudflare Workers AI (fast images): dash.cloudflare.com -> Account ID + API token (Workers AI permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional Pollinations key: https://enter.pollinations.ai
POLLINATIONS_KEY=
# FREE real motion (person moves hands/legs/mouth): Hugging Face token (read): https://huggingface.co/settings/tokens  (~4-6 clips/day free)
HF_TOKEN=
# PAID real-life video for every scene: fal.ai key https://fal.ai/dashboard/keys
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/o3/standard/image-to-video
